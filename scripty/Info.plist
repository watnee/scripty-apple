<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app's only cryptography is HTTPS to the Scripty API, which is exempt
	     from export regulations. Saying so here means a TestFlight upload does
	     not stop and wait for someone to answer that question by hand. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- The signing team, with its trailing dot, substituted at build time.
	     macOS spells an App Group `TEAMID.group.…` where iOS spells it plain
	     `group.…`, and the container can only be opened by the exact string the
	     entitlement granted — so SongsNotesWidgetStore has to be able to build
	     the prefixed form, and this is where it reads the prefix from. Empty on
	     a simulator build, which has no profile and wants the plain form
	     anyway. -->
	<key>TeamIdentifierPrefix</key>
	<string>$(TeamIdentifierPrefix)</string>

	<!-- Courier Prime, the screenplay face the web editor names and the one
	     every block falls back to. iOS ships Courier New but not this, so the
	     four faces travel with the app; registering them here is what makes
	     "CourierPrime" resolvable by name. SIL Open Font License 1.1 — the
	     text is in Resources/Fonts/OFL.txt and in the fonts themselves. -->
	<key>UIAppFonts</key>
	<array>
		<string>CourierPrime-Regular.ttf</string>
		<string>CourierPrime-Bold.ttf</string>
		<string>CourierPrime-Italic.ttf</string>
		<string>CourierPrime-BoldItalic.ttf</string>
	</array>

	<!-- The fixed half of the Home Screen's long-press menu. Songs and Notes are
	     declared here rather than published at runtime so they are offered on a
	     fresh install, before the app has ever launched and had the chance to
	     say anything about itself. The recent projects join them from
	     QuickActions.publishRecents, and iOS lists the static pair first.

	     The type strings have to match QuickAction.ItemType. A disagreement
	     builds cleanly and shows up only as a menu entry that does nothing. -->
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>scripty.songs</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Songs</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>In your default screenplay</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>music.note.list</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>scripty.notes</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Notes</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>In your default screenplay</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>note.text</string>
		</dict>
	</array>

	<!-- scripty://demo launches the offline demo (e.g. from a Shortcut). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>scripty.scripty</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>scripty</string>
			</array>
		</dict>
	</array>

	<!-- MusicXML, which no version of iOS declares. Without this the file
	     picker greys out every score, because a type it has never heard of
	     cannot be in a list of allowed types. Imported rather than exported:
	     the format is Recordare's, and other apps on the device may well have
	     a better claim to it. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.recordare.musicxml</string>
			<key>UTTypeDescription</key>
			<string>MusicXML Score</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.xml</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>musicxml</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.recordare.musicxml+xml</string>
				</array>
			</dict>
		</dict>
		<!-- The zipped form, which is what MuseScore writes by default. It is
		     an archive rather than XML, so it cannot share the declaration
		     above however alike the two look from the outside. -->
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.recordare.musicxml.compressed</string>
			<key>UTTypeDescription</key>
			<string>Compressed MusicXML Score</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mxl</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.recordare.musicxml</string>
				</array>
			</dict>
		</dict>
	</array>

	<!-- Payload for dragging a script element onto another to reorder it.
	     Declared so a drop only accepts elements dragged from this app; a
	     plain-text type would let any dragged text land on the script. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>scripty.scripty.block</string>
			<key>UTTypeDescription</key>
			<string>Script Element</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
