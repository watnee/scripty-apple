<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox is required of a Mac app; ignored on iOS. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Reach the Scripty backend. Without this the sandbox blocks all networking. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Export writes files the writer picks; import reads them. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Passkeys are bound to the server's domain: iOS only offers them to
	     this app after validating the domain's apple-app-site-association
	     (which the server serves at /.well-known/). A different base URL
	     (localhost override, demo) simply can't run the ceremony. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:web-production-ce5bc3.up.railway.app</string>
	</array>
</dict>
</plist>
