<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	The Mac Catalyst build's entitlements, selected by
	CODE_SIGN_ENTITLEMENTS[sdk=macosx*].

	This file exists for one line. macOS spells an App Group `TEAMID.group.…`
	and rejects the plain form; iOS spells it `group.…` and rejects the prefixed
	one. Nothing in an entitlements file is conditional, so the only way to say
	both is to have two files — and having two means every *other* change has to
	be made twice. Keep this in step with scripty.entitlements next door.
-->
<plist version="1.0">
<dict>
	<!-- App Sandbox is required of a Mac app; ignored on iOS. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Reach the Scripty backend. Without this the sandbox blocks all networking. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Export writes files the writer picks; import reads them. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Shared with the ProjectsWidget extension — the macOS spelling of the
	     group in scripty.entitlements. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)group.scripty.scripty</string>
	</array>
	<!-- Both claims are on the server's domain, validated by iOS against the
	     apple-app-site-association the server serves at /.well-known/. A
	     different base URL (localhost override, demo) matches neither.

	     webcredentials: passkeys are bound to the domain, and iOS only offers
	     them to this app once the file names it.

	     applinks: the password reset link in a recovery email opens this app
	     rather than a browser, which is what spares anyone typing a code out of
	     the mail. The file claims only /forgot-password/reset?token=…, so every
	     other page on the domain still opens in the browser. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:web-production-ce5bc3.up.railway.app</string>
		<string>applinks:web-production-ce5bc3.up.railway.app</string>
	</array>
</dict>
</plist>
