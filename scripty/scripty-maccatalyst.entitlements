<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	The Mac Catalyst build's entitlements, selected by
	CODE_SIGN_ENTITLEMENTS[sdk=macosx*].

	Identical to scripty.entitlements but for the App Group, which macOS spells
	with the team prefix: `TEAMID.group.…` rather than plain `group.…`. The two
	forms cannot live in one file — the prefixed one is not a valid iOS group
	and fails provisioning there — so this is a copy that differs by one line.
	Anything added to scripty.entitlements belongs here too.
-->
<plist version="1.0">
<dict>
	<!-- App Sandbox is required of a Mac app; ignored on iOS. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Reach the Scripty backend. Without this the sandbox blocks all networking. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Export writes files the writer picks; import reads them. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- The widget's shared container. `$(TeamIdentifierPrefix)` is expanded at
	     build time and already carries its trailing dot, so this resolves to
	     e.g. WA6FZ2S8R3.group.scripty.scripty — which is what
	     `containerURL(forSecurityApplicationGroupIdentifier:)` must be handed on
	     macOS. SongsNotesWidgetStore tries both spellings for that reason. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)group.scripty.scripty</string>
	</array>
	<!-- Both claims are on the server's domain, validated against the
	     apple-app-site-association the server serves at /.well-known/. A
	     different base URL (localhost override, demo) matches neither.

	     webcredentials: passkeys are bound to the domain, and the system only
	     offers them to this app once the file names it.

	     applinks: the password reset link in a recovery email opens this app
	     rather than a browser, which is what spares anyone typing a code out of
	     the mail. The file claims only /forgot-password/reset?token=…, so every
	     other page on the domain still opens in the browser. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:web-production-ce5bc3.up.railway.app</string>
		<string>applinks:web-production-ce5bc3.up.railway.app</string>
	</array>
</dict>
</plist>
